rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dream Computer Patna - Cloud Firestore Security Rules
    // Allows public store reads and direct catalog seeding

    match /products/{document=**} {
      allow read, write: if true;
    }

    match /categories/{document=**} {
      allow read, write: if true;
    }

    match /brands/{document=**} {
      allow read, write: if true;
    }

    match /attributes/{document=**} {
      allow read, write: if true;
    }

    match /banners/{document=**} {
      allow read, write: if true;
    }

    match /testimonials/{document=**} {
      allow read, write: if true;
    }

    match /settings/{document=**} {
      allow read, write: if true;
    }

    match /bookings/{document=**} {
      allow read, write: if true;
    }

    match /inventoryLogs/{document=**} {
      allow read, write: if true;
    }

    match /analyticsEvents/{document=**} {
      allow read, write: if true;
    }

    match /adminUsers/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
