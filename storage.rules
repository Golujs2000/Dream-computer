rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null;
    }

    // Anyone can read images
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && 
        request.resource.size < 10 * 1024 * 1024 && // Max 10MB
        request.resource.contentType.matches('image/.*');
    }
  }
}
